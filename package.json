{
  "name": "lynx-media",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "check": "eslint . && tsc --noEmit",
    "build": "next build",
    "dev": "next dev -p 3000",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:seed": "prisma db seed",
    "db:bootstrap:auth": "tsx prisma/bootstrap.auth.ts",
    "db:create:invite": "tsx prisma/create-invite.ts",
    "db:seed:reset": "cross-env RESET_CONFIRM=YES tsx prisma/seed.reset.ts",
    "db:seed:bulk": "tsx prisma/seed.bulk.ts",
    "db:seed:modules": "tsx prisma/seed.modules.ts",
    "db:seed:tickets": "tsx prisma/seed.tickets.ts",
    "db:backfill:playlists": "tsx prisma/backfill.playlists.ts",
    "db:catalog:reset-main-tracks": "tsx prisma/reset.main-catalog-tracks.ts",
    "auth:preflight": "node scripts/auth-email-preflight.mjs",
    "auth:provision-supabase": "tsx prisma/provision.supabase-auth.ts",
    "auth:set-supabase-password": "tsx prisma/set-supabase-password.ts",
    "assets:migrate-r2": "tsx --env-file=.env.local prisma/migrate.track-assets.ts",
    "worker:audio": "tsx --env-file=.env.local workers/audio-worker.ts",
    "worker:audio:once": "tsx --env-file=.env.local workers/audio-worker.ts --once",
    "worker:audio:e2e": "tsx --env-file=.env.local scripts/audio-worker-e2e.ts",
    "test": "vitest run -c vitest.config.ts",
    "test:contract": "vitest run -c vitest.contract.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-presigned-post": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "0.10.0",
    "@supabase/supabase-js": "2.100.1",
    "@t3-oss/env-nextjs": "^0.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "execa": "^8.0.1",
    "lucide-react": "^0.560.0",
    "mime-types": "^3.0.1",
    "next": "^16.3.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/eslint-plugin-next": "^16.3.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20.19.11",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "ffmpeg-static": "^4.4.1",
    "ffprobe-static": "^3.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.14.0",
    "vitest": "^4.0.8"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "packageManager": "npm@10.6.0"
}
