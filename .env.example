# Since ".env.local" is gitignored, use ".env.example" to create your local
# env file when you clone the repo. Keep this file up-to-date when you add
# new variables to `.env.local`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, copy this file to
# ".env.local" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL=postgresql://USER:PASS@HOST:5432/postgres?sslmode=require
# Recomendado para migraciones Prisma (si usas host directo separado del pooler)
DIRECT_URL=postgresql://USER:PASS@HOST:5432/postgres?sslmode=require

# ─── Admin (elige al menos una) ───────────────────────────────────────────────
# Si defines ambas, el sistema usa ADMIN_ACCESS_KEY como valor esperado de cookie.
ADMIN_ACCESS_KEY=CHANGE_ME_ADMIN_KEY
ADMIN_PASS=CHANGE_ME_ADMIN_PASS
ADMIN_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
# Nuevo secret principal para sesiones por cuenta (si no está, usa ADMIN_SESSION_SECRET).
AUTH_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
# Bootstrap inicial del usuario admin real en DB (opcional recomendado).
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@lynx.local
AUTH_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_BOOTSTRAP_PASSWORD
# Base URL usada para links de invitación (script db:create:invite).
APP_BASE_URL=http://localhost:3000
# Email transaccional (v2 auth)
AUTH_EMAIL_PROVIDER=console
AUTH_EMAIL_FROM=noreply@lynx.local
AUTH_EMAIL_DEBUG_LINKS=1
AUTH_ENFORCE_VERIFIED_EMAIL=0
BREVO_API_KEY=
# CSRF (formularios públicos): openssl rand -base64 32
CSRF_SECRET=CHANGE_ME_CSRF_SECRET_MIN_32_CHARS

# Turnstile (Cloudflare)
TURNSTILE_ENABLED=0
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# ADMIN_PASS=pon_una_clave_alternativa

# ─── Integración Google Apps Script/Sheets (opcional, si la estás usando) ────
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_WEBAPP_ID/exec
GOOGLE_SCRIPT_TOKEN=REPLACE_WITH_TOKEN

# ─── Debug (opcional) ────────────────────────────────────────────────────────
# DEBUG_ADMIN_MW=1

# Opcional: enlazar token al User-Agent (hace más difícil robar la cookie)
# 1 = activo / cualquier otra cosa = inactivo
ADMIN_BIND_UA=0
