# Since ".env.local" is gitignored, use ".env.example" to create your local
# env file when you clone the repo. Keep this file up-to-date when you add
# new variables to `.env.local`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, copy this file to
# ".env.local" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL=postgresql://USER:PASS@HOST:5432/postgres?sslmode=require
# Recomendado para migraciones Prisma (si usas host directo separado del pooler)
DIRECT_URL=postgresql://USER:PASS@HOST:5432/postgres?sslmode=require

# ─── Admin (elige al menos una) ───────────────────────────────────────────────
# Si defines ambas, el sistema usa ADMIN_ACCESS_KEY como valor esperado de cookie.
ADMIN_ACCESS_KEY=CHANGE_ME_ADMIN_KEY
ADMIN_PASS=CHANGE_ME_ADMIN_PASS
ADMIN_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
# Nuevo secret principal para sesiones por cuenta (si no está, usa ADMIN_SESSION_SECRET).
AUTH_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
# Obligatorio en producción para formularios públicos con CSRF. Usa 32+ bytes aleatorios.
CSRF_SECRET=CHANGE_ME_LONG_RANDOM_CSRF_SECRET
# Bootstrap inicial del usuario admin real en DB (opcional recomendado).
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@lynx.local
AUTH_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_BOOTSTRAP_PASSWORD
# Base URL usada para links de invitación (script db:create:invite).
APP_BASE_URL=http://localhost:3000
# Origen público server-only para SSR/URLs absolutas. En producción debe ser HTTPS.
APP_URL=http://localhost:3000
# Email transaccional (v2 auth)
AUTH_EMAIL_PROVIDER=console
AUTH_EMAIL_FROM=noreply@lynx.local
AUTH_EMAIL_DEBUG_LINKS=1
AUTH_ENFORCE_VERIFIED_EMAIL=0
BREVO_API_KEY=
# Turnstile (Cloudflare)
TURNSTILE_ENABLED=0
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Cloudflare R2 / TrackAsset (FASE 2) ────────────────────────────────────
# Dos buckets físicos: previews públicos y originales/entregables privados.
R2_ACCOUNT_ID=
# Opcional si se define R2_ACCOUNT_ID.
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREVIEWS_BUCKET=lynx-previews
R2_PRIVATE_BUCKET=lynx-private-assets
# Dominio público dedicado del bucket lynx-previews, sin slash final.
R2_PUBLIC_PREVIEW_URL=https://previews.example.com
# 32+ caracteres; puede rotarse sin afectar objetos ya almacenados.
ASSET_UPLOAD_SIGNING_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS

# ─── Procesamiento de audio local (FASE 3) ───────────────────────────────────
# Las rutas HTTP siempre responden 202 y el worker separado ejecuta FFmpeg.
# Frecuencia del worker continuo. El worker no abre puertos.
AUDIO_WORKER_POLL_MS=5000
# Opcionales: rutas explícitas si FFmpeg/FFprobe no están en PATH.
FFMPEG_PATH=
FFPROBE_PATH=
UPLOAD_MAX_PREVIEW_MB=50
UPLOAD_MAX_PRIVATE_MB=500
UPLOAD_ALLOWED_MIME=audio/mpeg,audio/wav,audio/x-wav,audio/flac,audio/ogg,audio/mp4,audio/aiff,audio/x-aiff

# Alias legacy: solo para dual-read y rollback durante la migración.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ─── Supabase Auth (FASE 1) ─────────────────────────────────────────────────
# legacy: auth actual; hybrid: Supabase con fallback legacy; supabase: solo Supabase.
AUTH_MODE=legacy
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SOLO servidor. Nunca usar prefijo NEXT_PUBLIC_ ni exponer en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_PASS=pon_una_clave_alternativa

# ─── Integración Google Apps Script/Sheets (opcional, si la estás usando) ────
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_WEBAPP_ID/exec
GOOGLE_SCRIPT_TOKEN=REPLACE_WITH_TOKEN

# ─── Debug (opcional) ────────────────────────────────────────────────────────
# DEBUG_ADMIN_MW=1

# Opcional: enlazar token al User-Agent (hace más difícil robar la cookie)
# 1 = activo / cualquier otra cosa = inactivo
ADMIN_BIND_UA=0
