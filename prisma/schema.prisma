// ================================================
// File: prisma/schema.prisma
// Título: Esquema Prisma (agrega Track para Fase B)
// Descripción: Define el modelo Track para guardar metadatos y el asset.
// Qué hace: Permite crear/listar tracks reales desde Postgres.
// Peras y manzanas: “Una fila por canción con su info y dónde está el archivo.”
// ================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Usa el pooler en runtime (DATABASE_URL) y el directo para migraciones (DIRECT_URL).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  STAFF
  CREATOR
  CLIENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model User {
  id              String     @id @default(cuid())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  email           String     @unique @db.Citext
  passwordHash    String
  name            String?
  role            UserRole   @default(CREATOR)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  sessions     UserSession[]
  resetTokens  PasswordResetToken[]
  verifyTokens EmailVerificationToken[]
  inviteTokens InviteToken[]

  ownedTracks     Track[]            @relation("TrackOwner")
  ownedLicensing  LicensingRequest[] @relation("LicensingOwner")
  ownedPlaylists  Playlist[]         @relation("PlaylistOwner")
  sharedPlaylists PlaylistViewer[]   @relation("PlaylistViewerUser")
  ownedSoundKits  SoundKit[]         @relation("SoundKitOwner")
  ownedServices   ServiceOffer[]     @relation("ServiceOwner")
  ownedContracts  ContractRecord[]   @relation("ContractOwner")
  reportedTickets SupportTicket[]    @relation("TicketReporter")
  resolvedTickets SupportTicket[]    @relation("TicketResolver")
}

model UserSession {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionTokenHash String   @unique
  expiresAt        DateTime
  ip               String?
  userAgent        String?

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model InviteToken {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String    @db.Citext
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  @@index([email])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuthRateLimit {
  key          String    @id
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  action       String
  windowStart  DateTime
  count        Int       @default(0)
  blockedUntil DateTime?

  @@index([action, windowStart])
  @@index([blockedUntil])
}

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Track {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title    String
  artist   String
  audioUrl String
  coverUrl String?

  // Metadata musical / creativa
  bpm       Float? // BPM promedio (permite decimales)
  key       String? // Ej: "C#m", "Bb", "Am"
  trackType TrackType?
  genres    String[]   @default([])
  subgenres String[]   @default([])

  // Derechos / licensing
  master          String?
  publishingSplit String? // JSON resumen opcional (legacy/compat)
  oneStop         Boolean?
  clearedForSync  Boolean?

  // Exclusividad / restricciones estructuradas
  exclusiveTerritories  String[] @default([])
  exclusiveTermMonths   Int?
  restrictedTerritories String[] @default([])
  restrictedIndustries  String[] @default([])
  restrictedPlatforms   String[] @default([])
  restrictedBrands      String[] @default([])

  // Publishing Share
  publishingShares PublishingShare[]
  masterShares     MasterShare[]

  // // Writer
  // writerName      String? // Ej: "Diego Fernández"
  // writerSharePct  Int? // Ej: 50 (representa 50%)
  // writerIpiNumber String?

  // // Publisher
  // publisherName      String? // Ej: "Lynx Publishing"
  // publisherSharePct  Int? // Ej: 50
  // publisherIpiNumber String?

  // Identificadores / derechos (MVP)
  isrc               String?
  iswc               String?
  upc                String?
  licenseType        String? // Ej: NON_EXCLUSIVE, EXCLUSIVE, LIMITED_EXCLUSIVE, BUYOUT
  mediaBuy           String?
  mfn                Boolean?
  restrictions       String[]
  contentIdEnrolled  Boolean?
  contentIdAdmin     String?
  contentIdWhitelist String?

  // Pricing / presupuesto (orientativo)
  pricingTier    PricingTier?
  budgetMin      Int?
  budgetMax      Int?
  budgetCurrency Currency?

  // Info del asset subido
  assetKey  String @default("") // "external://..." si es URL directa
  assetMime String @default("")
  assetSize Int    @default(0)

  // Campos técnicos (Fase C)
  /// C2 — Campos técnicos de análisis (opcionales)
  durationSec     Int?      @db.Integer // segundos (redondeado)
  loudnessLufs    Float?    @db.DoublePrecision
  // NUEVO:
  loudnessRangeLu Float? // LRA en LU
  lraLowLufs      Float? // LRA low en LUFS
  lraHighLufs     Float? // LRA high en LUFS
  truePeakDbfs    Float? // True Peak en dBFS (negativo)
  waveform        Bytes?
  sampleRateHz    Int?
  channels        Int?
  bitrateKbps     Int?
  analysisAt      DateTime?

  // Versiones y stems (relaciones)
  versions    TrackVersion[]
  stems       TrackStem[]
  tags        TrackTag[]
  moodLinks   TrackMood[]
  playlists   PlaylistTrack[]
  contracts   ContractRecord[]
  ownerUserId String?
  owner       User?            @relation("TrackOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([artist])
  @@index([title])
  @@index([ownerUserId, updatedAt, id])
  @@index([createdAt, id]) // ← nuevo
  @@index([updatedAt, id])
}

enum TrackType {
  INSTRUMENTAL
  VOCAL
  VOCAL_INSTRUMENTAL
  OTHER
}

enum PricingTier {
  LOW
  MID
  HIGH
  BESPOKE
}

enum TrackVersionKind {
  FULL
  CUTDOWN
  ALT_MIX
  INSTRUMENTAL
  VOCAL
  OTHER
}

enum StemGroup {
  INSTRUMENT
  VOCAL
  FX
  PERCUSSION
  OTHER
}

model TrackVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  label       String
  durationSec Int?
  kind        TrackVersionKind?
  audioUrl    String?
  assetKey    String?
  sortOrder   Int?

  @@index([trackId, sortOrder])
}

model TrackStem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  name        String
  group       StemGroup?
  durationSec Int?
  audioUrl    String?
  assetKey    String?
  sortOrder   Int?

  @@index([trackId, sortOrder])
}

enum PublishingRole {
  WRITER
  PUBLISHER
}

model PublishingShare {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con Track
  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  role      PublishingRole // WRITER o PUBLISHER
  name      String // Nombre/entidad
  pro       String? // PRO/Sociedad (ej: SCD, ASCAP, BMI)
  caeNumber String? // CAE (si aplica)
  ipiNumber String? // IPI opcional
  sharePct  Int? // 0–100 (puede ser null mientras no se complete)
  sortOrder Int?
  // pro      String?      // (si quieres agregar luego la sociedad PRO)

  @@index([trackId, role, sortOrder])
}

model MasterShare {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  name      String
  sharePct  Int?
  contact   String?
  notes     String?
  sortOrder Int?

  @@index([trackId])
  @@index([trackId, sortOrder])
}

// ───────────────────────────────────────────────────────────────────────────────
// Modelo para almacenar solicitudes de licencias desde el formulario D3
// ───────────────────────────────────────────────────────────────────────────────
enum Currency {
  CLP
  USD
  EUR
}

// ───────────────────────────────────────────────────────────────────────────────
// Prisma: Estado mínimo del pipeline comercial
// Peras y manzanas:
// - Creamos un enum RequestStatus con 5 estados básicos.
// - Agregamos el campo "status" a LicensingRequest con default NEW.
// - No tocamos nada más del modelo para mantenerlo minimal.
// ───────────────────────────────────────────────────────────────────────────────

enum RequestStatus {
  NEW
  IN_REVIEW
  QUOTED
  CLOSED_WON
  CLOSED_LOST
}

model LicensingRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Responsable (owner) de la gestión comercial de esta solicitud
  assignee    String?
  ownerUserId String?
  owner       User?   @relation("LicensingOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  // Solicitante
  name    String
  email   String
  company String?

  // Proyecto
  projectType    String
  media          String?
  territories    String?
  term           String?
  budgetAmount   Int?
  budgetCurrency Currency?
  mfn            Boolean   @default(false)
  needWhitelist  Boolean   @default(false)
  notes          String?

  // Contexto de track
  trackId          String
  trackTitle       String?
  trackArtist      String?
  trackDurationSec Int?
  moods            String[]
  uses             String[]
  restrictions     String[]

  pageUrl String?

  // Respaldo del JSON completo (auditoría)
  rawPayload Json?

  // Estado del pipeline (mínimo viable para gestión)
  status RequestStatus @default(NEW)

  /// Notas internas de gestión (no se envían al cliente)
  internalNotes String? @db.Text

  /// Prioridad de gestión comercial
  priority RequestPriority @default(MEDIUM)

  /// Próximo seguimiento (fecha/hora local convertida a UTC)
  nextFollowUpAt DateTime?

  @@index([createdAt, status])
  @@index([ownerUserId, createdAt])
  @@index([assignee])
  @@index([priority])
  @@index([nextFollowUpAt])
}

// ───────────────────────────────────────────────────────────────────────────────
// Prisma: Seguimiento mínimo (prioridad + próximo follow-up)
// Peras y manzanas:
// - Enum RequestPriority: LOW/MEDIUM/HIGH (por defecto MEDIUM).
// - Campo nextFollowUpAt: fecha/hora opcional del próximo seguimiento.
// - Índices sugeridos para listados y filtros.
// ───────────────────────────────────────────────────────────────────────────────

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum TicketSeverity {
  LOW
  MEDIUM
  HIGH
}

enum TicketSource {
  NOT_FOUND
  ERROR_PAGE
  MANUAL
}

enum PlaylistStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PlaylistVisibility {
  PRIVATE
  INTERNAL
  PUBLIC
}

enum SoundKitStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ServiceOfferStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum BannerPlacement {
  CATALOG_HERO
}

enum BannerTargetType {
  TRACK
  PLAYLIST
  SOUND_KIT
  SERVICE_OFFER
  ARTIST
  EXTERNAL_URL
}

enum PromotionSlotFormat {
  HERO
  SLIDER
  STRIP
  GRID
  BANNER
}

enum PromotionCampaignStatus {
  DRAFT
  LIVE
  PAUSED
  ARCHIVED
}

enum ServiceCategory {
  MIX_MASTER
  PRODUCTION
  COMPOSITION
  SOUND_DESIGN
  OTHER
}

enum ContractStatus {
  DRAFT
  SENT
  NEGOTIATION
  SIGNED
  EXPIRED
  CANCELED
}

// ───────────────────────────────────────────────────────────────────────────────
// Modelo para solicitudes de contacto generales (homepage)
// ───────────────────────────────────────────────────────────────────────────────
model ContactRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  email       String
  serviceType String
  details     String
  urgency     Int
  deadlineAt  DateTime?

  pageUrl    String?
  rawPayload Json?

  status RequestStatus @default(NEW)

  @@index([createdAt, status])
  @@index([serviceType])
}

model SupportTicket {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source   TicketSource   @default(MANUAL)
  status   TicketStatus   @default(OPEN)
  severity TicketSeverity @default(MEDIUM)

  summary String
  details String

  pageUrl   String?
  email     String? @db.Citext
  userAgent String?
  ipHash    String?

  reporterUserId String?
  reporter       User?   @relation("TicketReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)

  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedBy       User?     @relation("TicketResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  meta Json?

  @@index([status, createdAt])
  @@index([severity, createdAt])
  @@index([source, createdAt])
  @@index([reporterUserId, createdAt])
  @@index([resolvedByUserId, createdAt])
}

model Playlist {
  id          String             @id @default(cuid())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  name        String
  publicId    String             @unique @db.Citext
  slug        String             @unique @db.Citext
  description String?
  status      PlaylistStatus     @default(DRAFT)
  visibility  PlaylistVisibility @default(INTERNAL)
  isMainCatalog Boolean          @default(false)
  embedEnabled  Boolean          @default(true)
  isAutoAllTracks Boolean        @default(false)
  coverUrl    String?
  featured    Boolean            @default(false)
  sortOrder   Int                @default(0)
  ownerUserId String?
  owner       User?              @relation("PlaylistOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  tracks      PlaylistTrack[]
  sharedWith  PlaylistViewer[]

  @@index([status, updatedAt])
  @@index([visibility, updatedAt])
  @@index([isMainCatalog, visibility, status, updatedAt])
  @@index([publicId])
  @@index([ownerUserId, updatedAt])
}

model PlaylistTrack {
  playlistId String
  trackId    String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@id([playlistId, trackId])
  @@index([trackId])
  @@index([playlistId, sortOrder])
}

model PlaylistViewer {
  playlistId String
  userId     String
  canEdit    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user     User     @relation("PlaylistViewerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([playlistId, userId])
  @@index([userId, createdAt])
}

model SoundKit {
  id          String         @id @default(cuid())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  name        String
  slug        String         @unique @db.Citext
  description String?
  status      SoundKitStatus @default(DRAFT)
  price       Int            @default(0)
  currency    Currency       @default(USD)
  coverUrl    String?
  previewUrl  String?
  featured    Boolean        @default(false)
  sortOrder   Int            @default(0)
  ownerUserId String?
  owner       User?          @relation("SoundKitOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([ownerUserId, updatedAt])
}

model ServiceOffer {
  id             String             @id @default(cuid())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  name           String
  slug           String             @unique @db.Citext
  category       ServiceCategory    @default(OTHER)
  status         ServiceOfferStatus @default(ACTIVE)
  description    String?
  priceFrom      Int?
  priceTo        Int?
  currency       Currency           @default(USD)
  turnaroundDays Int?
  featured       Boolean            @default(false)
  sortOrder      Int                @default(0)
  ownerUserId    String?
  owner          User?              @relation("ServiceOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([category, status, updatedAt])
  @@index([ownerUserId, updatedAt])
}

model PromotionSlot {
  id          String             @id @default(cuid())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  key         String             @unique
  name        String
  format      PromotionSlotFormat @default(HERO)
  description String?
  isEnabled   Boolean            @default(true)
  settings    Json?
  campaigns   BannerPromotion[]

  @@index([isEnabled, updatedAt])
  @@index([format, updatedAt])
}

model BannerPromotion {
  id        String          @id @default(cuid())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  name      String
  placement BannerPlacement?
  slotId    String?
  slot      PromotionSlot?  @relation(fields: [slotId], references: [id], onDelete: SetNull)
  status    PromotionCampaignStatus @default(DRAFT)
  priority  Int             @default(0)
  isActive  Boolean         @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  notes     String?
  items     BannerPromotionItem[]

  @@index([placement, isActive, startsAt, endsAt, updatedAt])
  @@index([slotId, status, startsAt, endsAt, updatedAt])
  @@index([slotId, priority, updatedAt])
}

model BannerPromotionItem {
  id               String           @id @default(cuid())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  promotionId      String
  promotion        BannerPromotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  targetType       BannerTargetType
  targetId         String?
  titleOverride    String?
  subtitleOverride String?
  imageUrlOverride String?
  ctaLabel         String?
  ctaHrefOverride  String?
  sortOrder        Int              @default(0)
  isEnabled        Boolean          @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  durationMs       Int              @default(5000)

  @@index([promotionId, sortOrder])
  @@index([isEnabled, startsAt, endsAt, sortOrder])
  @@index([targetType, targetId])
}

model BannerPromotionEvent {
  id        String          @id @default(cuid())
  createdAt DateTime        @default(now())
  placement BannerPlacement
  itemId    String?
  eventType String
  sessionId String?
  path      String?
  userAgent String?
  ip        String?

  @@index([placement, createdAt])
  @@index([itemId, createdAt])
  @@index([eventType, createdAt])
}

model ContractRecord {
  id                String         @id @default(cuid())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  contractNumber    String         @unique
  title             String
  counterpartyName  String
  counterpartyEmail String?
  status            ContractStatus @default(DRAFT)
  amount            Int?
  currency          Currency       @default(USD)
  startsAt          DateTime?
  endsAt            DateTime?
  signedAt          DateTime?
  fileUrl           String?
  notes             String?
  requestId         String?
  trackId           String?
  track             Track?         @relation(fields: [trackId], references: [id], onDelete: SetNull)
  ownerUserId       String?
  owner             User?          @relation("ContractOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([counterpartyName, updatedAt])
  @@index([ownerUserId, updatedAt])
  @@index([trackId])
  @@index([requestId])
}

// ───────────────────────────────────────────────────────────────────────────────
// Catálogos (beats/sync) y tags escalables
// ───────────────────────────────────────────────────────────────────────────────

model Catalog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug        String  @unique
  name        String
  description String?
  filterJson  Json?

  @@index([slug])
}

enum TagType {
  CATALOG
  GENERIC
  MOOD
  USE
}

model Tag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug String  @unique
  name String
  type TagType @default(GENERIC)

  tracks TrackTag[]

  @@index([slug])
  @@index([type])
  @@index([type, name])
}

// ───────────────────────────────────────────────────────────────────────────────
// Mood catalog (vocabulario controlado para chips/autocompletar)
// ───────────────────────────────────────────────────────────────────────────────

model Mood {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name     String  @unique @db.Citext
  slug     String  @unique @db.Citext
  category String?

  tracks TrackMood[]

  @@index([name])
  @@index([slug])
}

model TrackMood {
  trackId    String
  moodId     String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  mood       Mood     @relation(fields: [moodId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([trackId, moodId])
  @@index([moodId])
  @@index([trackId])
}

model TrackTag {
  trackId    String
  tagId      String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([trackId, tagId])
  @@index([tagId])
  @@index([trackId])
  @@index([trackId, assignedAt])
  @@index([tagId, assignedAt])
}
